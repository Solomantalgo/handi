const $ = s => document.querySelector(s);
const cartKey = 'haandi-cart-v1';
const state = {mode:'food',category:'all',search:'',vegetarian:false,cart:loadCart(),service:'dine-in',customer:{},detail:null,dialog:null,returnFocus:null};
function loadCart(){try{const v=JSON.parse(localStorage.getItem(cartKey)||'[]');if(!Array.isArray(v))return[];return v.filter(x=>x&&typeof x==='object'&&typeof x.id==='string'&&typeof x.name==='string'&&Number.isInteger(x.qty)&&x.qty>0&&x.qty<100&&typeof x.key==='string'&&(x.price==null||Number.isFinite(x.price))).map(x=>({key:x.key,id:x.id,name:x.name,description:typeof x.description==='string'?x.description:'',price:Number.isFinite(x.price)?x.price:null,image:typeof x.image==='string'?x.image:'',qty:x.qty,preferences:{...(x.preferences&&typeof x.preferences==='object'?x.preferences:{}),...(x.spice?{spice:x.spice}:{}),...(x.notes?{notes:x.notes}:{})}}))}catch{return[]}}
function saveCart(){try{localStorage.setItem(cartKey,JSON.stringify(state.cart))}catch{}renderCartCount()}
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function toast(s){const el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
function activeCats(){return state.mode==='food'?FOOD_CATEGORIES:DRINK_GROUPS.map(g=>[g.id,g.name])}
function renderNav(){ $('#categoryNav').innerHTML=activeCats().map(([id,n])=>{const count=state.mode==='food'?FOOD.filter(x=>x.category===id).length:DRINKS.filter(x=>x.category===id).length;const thumb=state.mode==='food'?`<img src="${FOOD_CATEGORY_IMAGES[id]}" alt="" loading="lazy" />`:'';return `<button class="category-link ${state.category===id?'selected':''}" data-category="${id}">${thumb?`<span class="category-thumb">${thumb}</span>`:`<span class="category-symbol">◌</span>`}<span class="category-name">${esc(n)}</span><small>${count}</small></button>`}).join('') }
function image(url){return url?`<div class="card-image"><img src="${esc(url)}" alt="" loading="lazy" onerror="this.parentElement.classList.add('missing-photo');this.remove()" /></div>`:'<div class="card-image photo-placeholder" role="img" aria-label="Photo not available"></div>'}
function renderFood(){const q=state.search.toLocaleLowerCase();const list=FOOD.filter(x=>(state.category==='all'||x.category===state.category)&&(!state.vegetarian||x.vegetarian)&&(!q||`${x.name} ${x.description}`.toLocaleLowerCase().includes(q)));$('#menuGrid').innerHTML=list.map(x=>`<article class="menu-card" data-id="${x.id}"><button class="photo-open item-open" type="button" aria-label="View details for ${esc(x.name)}">${image(x.image)}</button><div class="card-body"><div class="card-meta">${x.vegetarian?'<span class="diet veg"><i></i>VEG</span>':''}${x.spice?`<span class="spice">${esc(x.spice)}</span>`:''}</div><button class="item-open" type="button" aria-label="View details for ${esc(x.name)}"><h3>${esc(x.name)}</h3></button><p>${esc(x.description)}</p><div class="card-bottom"><span class="price">Price to be confirmed</span><button class="add-item" data-add="${esc(x.id)}" type="button" aria-label="Add ${esc(x.name)} to order">Add <span aria-hidden="true">＋</span></button></div></div></article>`).join('');$('#resultCount').textContent=`${list.length} ${list.length===1?'item':'items'}`;$('#emptyState').hidden=!!list.length;$('#menuGrid').hidden=!list.length;renderCategoryHeader(list)}
function renderCategoryHeader(list){const el=$('#selectedCategoryHeader');if(state.mode!=='food'||state.category==='all'){el.hidden=true;el.innerHTML='';return}const cat=FOOD_CATEGORIES.find(x=>x[0]===state.category),src=FOOD_CATEGORY_IMAGES[state.category];el.hidden=false;el.innerHTML=`<img src="${src}" alt="" /><div class="category-heading-wash"></div><div class="selected-category-copy"><h2>${esc(cat?.[1]||'Food')}</h2><span>${list.length} ${list.length===1?'dish':'dishes'}</span></div>`}
function renderDrinks(){const q=state.search.toLocaleLowerCase();const list=DRINKS.filter(x=>(state.category==='all'||x.category===state.category)&&(!q||`${x.name} ${x.description} ${x.subcategory}`.toLocaleLowerCase().includes(q)));const groups=DRINK_GROUPS.map(g=>({...g,items:list.filter(x=>x.category===g.id)})).filter(g=>g.items.length);$('#menuGrid').innerHTML=groups.map(g=>`<section class="drink-group"><div class="drink-group-head"><span class="group-index">${String(DRINK_GROUPS.indexOf(DRINK_GROUPS.find(x=>x.id===g.id))+1).padStart(2,'0')}</span><div><div class="eyebrow">${esc(g.name.toUpperCase())}</div><h3>${esc(g.name)}</h3></div></div>${[...new Set(g.items.map(x=>x.subcategory))].map(sub=>`<div class="drink-sub"><h4>${esc(sub)}</h4><div class="drink-card-grid">${g.items.filter(x=>x.subcategory===sub).map(x=>`<article class="menu-card drink-card" data-id="${esc(x.id)}"><button class="photo-open item-open" type="button" aria-label="View details for ${esc(x.name)}">${image(x.image)}</button><div class="card-body"><div class="card-meta">${x.alcoholic?'<span class="drink-class alcoholic">ALCOHOLIC</span>':'<span class="drink-class">NON-ALCOHOLIC</span>'}${x.serving?`<span class="spice">${esc(x.serving)}</span>`:''}</div><button class="item-open" type="button" aria-label="View details for ${esc(x.name)}"><h3>${esc(x.name)}</h3></button>${x.description?`<p>${esc(x.description)}</p>`:'<p class="description-empty">&nbsp;</p>'}<div class="card-bottom"><span class="price">Price to be confirmed</span><button class="add-item" data-add="${esc(x.id)}" type="button" aria-label="Add ${esc(x.name)} to order">Add <span aria-hidden="true">＋</span></button></div></div></article>`).join('')}</div></div>`).join('')}</section>`).join('');$('#resultCount').textContent=`${list.length} ${list.length===1?'drink':'drinks'}`;$('#emptyState').hidden=!!list.length;$('#emptyState h3').textContent='No drinks found';$('#menuGrid').hidden=!list.length;renderCategoryHeader([])}
function setIntro(){const food=state.mode==='food';$('#menuIntro').dataset.mode=state.mode;$('#introBanner').src=food?'images/banners/menu-intro.webp':'images/banners/drinks-intro.webp';$('#introHeading').innerHTML=food?'Explore Our <em>Menu</em>':'Explore Our <em>Drinks</em>'}
function render(){renderNav();const food=state.mode==='food';setIntro();$('#resultKicker').textContent=food?'FOOD MENU':'DRINKS MENU';$('#resultTitle').textContent=state.category==='all'?(food?'All food':'All drinks'):(activeCats().find(x=>x[0]===state.category)||['','All'])[1];$('#categoryLabel').textContent=state.category==='all'?(food?'All food':'All drinks'):$('#resultTitle').textContent;$('#vegToggle').hidden=!food;food?renderFood():renderDrinks();document.querySelector('[data-mode="food"] small').textContent=`${FOOD.length} dishes`;document.querySelector('[data-mode="drinks"] small').textContent=`${DRINKS.length} drinks`}
function renderCartCount(){$('#cartCount').textContent=state.cart.reduce((n,x)=>n+x.qty,0)}
function identity(item,prefs){return `${item.id}|${item.variantId||''}|${prefs.spice||''}|${prefs.notes||''}`}
function add(item,prefs={}){const key=identity(item,prefs),line=state.cart.find(x=>x.key===key);if(line)line.qty++;else state.cart.push({key,id:item.id,name:item.name,description:item.description||'',price:item.price??null,image:item.image||'',qty:1,preferences:Object.fromEntries(Object.entries(prefs).filter(([,v])=>v))});saveCart();toast(`${item.name} added to your order`)}
function focusables(el){return [...el.querySelectorAll('button:not([disabled]),a[href],input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])')].filter(x=>!x.closest('[inert]'))}
function showSheet(which,origin=document.activeElement){closeSheets(false);const el=which==='detail'?$('#detailSheet'):$('#orderSheet');state.returnFocus=origin;state.dialog=el;el.inert=false;$('.site-shell').inert=true;el.classList.add('open');el.setAttribute('aria-hidden','false');document.body.classList.add('sheet-open');$('#backdrop').hidden=false;setTimeout(()=>focusables(el)[0]?.focus(),0)}
function closeSheets(restore=true){if(!state.dialog)return;const prior=state.returnFocus;state.dialog.classList.remove('open');state.dialog.setAttribute('aria-hidden','true');state.dialog.inert=true;state.dialog=null;$('.site-shell').inert=false;document.body.classList.remove('sheet-open');$('#backdrop').hidden=true;if(restore&&prior?.isConnected)prior.focus()}
function openDetail(item,origin){const drink=!!item.category&&DRINK_GROUPS.some(x=>x.id===item.category);$('#detailContent').innerHTML=`${image(item.image)}<div class="detail-copy"><div class="card-meta">${item.alcoholic===true?'<span class="drink-class alcoholic">ALCOHOLIC</span>':item.alcoholic===false?'<span class="drink-class">NON-ALCOHOLIC</span>':''}${item.spice?`<span class="spice">${esc(item.spice)}</span>`:''}</div><h2 id="detailName">${esc(item.name)}</h2><p>${esc(item.description||'')}</p>${item.serving?`<p class="detail-note">Serving: ${esc(item.serving)}</p>`:''}<p class="detail-note">${drink?'Availability and serving are subject to restaurant confirmation.':'Your preference is a request for the kitchen and is subject to restaurant confirmation.'}</p>${!drink?`<label class="field-label">Spice preference<select id="spicePref"><option value="">Use menu default${item.spice?` (${esc(item.spice)})`:''}</option><option>Mild</option><option>Medium</option><option>Spicy</option><option>Less spicy</option><option>More spicy</option></select></label>`:''}<label class="field-label">Special instructions<textarea id="itemNotes" rows="3" placeholder="Less salt, no garnish..."></textarea></label><div class="detail-actions"><span>${item.price==null?'Price to be confirmed':esc(item.price)}</span><button class="primary-button" id="detailAdd" type="button">Add to order <span>＋</span></button></div></div>`;showSheet('detail',origin);$('#detailAdd').onclick=()=>{add(item,{spice:$('#spicePref')?.value||'',notes:$('#itemNotes').value.trim()});closeSheets()}}
function saveCustomer(){const f=$('#checkoutForm');if(f)state.customer=Object.fromEntries(new FormData(f).entries())}
function subtotal(){return state.cart.every(x=>Number.isFinite(x.price)&&x.price>=0)?state.cart.reduce((n,x)=>n+x.price*x.qty,0):null}
function fmt(n){return new Intl.NumberFormat('en-UG',{style:'currency',currency:'UGX',maximumFractionDigits:0}).format(n)}
function renderOrder(){const has=state.cart.length;const total=subtotal();const lines=state.cart.map((x,i)=>`<div class="order-line"><div class="line-thumb">${x.image?`<img src="${esc(x.image)}" alt="" />`:''}</div><div class="line-main"><b>${esc(x.name)}</b><small>${esc(Object.entries(x.preferences||{}).map(([k,v])=>`${k}: ${v}`).join(' · ')||'No special instructions')}</small><div class="qty"><button data-dec="${i}" type="button" aria-label="Decrease ${esc(x.name)}">−</button><span>${x.qty}</span><button data-inc="${i}" type="button" aria-label="Increase ${esc(x.name)}">＋</button><button class="remove" data-remove="${i}" type="button">Remove</button></div></div><span class="line-price">${x.price==null?'TBC':fmt(x.price*x.qty)}</span></div>`).join('');const cf=state.customer;const contact=state.service==='dine-in'?`<label>Table number<input name="table" required placeholder="e.g. 14" value="${esc(cf.table||'')}" /></label>`:`<label>Phone number<input name="phone" required placeholder="+256 ..." value="${esc(cf.phone||'')}" /></label>`;const extras=state.service==='takeaway'?`<label>Preferred pickup time<input name="time" required placeholder="e.g. 19:30" value="${esc(cf.time||'')}" /></label>`:state.service==='delivery'?`<label>Address<input name="address" required placeholder="Delivery address" value="${esc(cf.address||'')}" /></label><label>Location link <small>(optional)</small><input name="location" placeholder="Google Maps link" value="${esc(cf.location||'')}" /></label>`:'';const preview=!CONFIG.liveOrdering||total===null;$('#orderContent').innerHTML=has?`${preview?'<div class="preview-banner"><span>PREVIEW MODE</span><p>Order details can be reviewed and copied. Restaurant confirmation is required.</p></div>':''}<div class="order-lines">${lines}</div><div class="order-total"><span>Subtotal</span><b>${total===null?'Price to be confirmed':fmt(total)}</b></div><div class="service-tabs"><button class="${state.service==='dine-in'?'active':''}" data-service="dine-in" type="button">Dine-in</button><button class="${state.service==='takeaway'?'active':''}" data-service="takeaway" type="button">Takeaway</button><button class="${state.service==='delivery'?'active':''}" data-service="delivery" type="button">Delivery</button></div><form id="checkoutForm" class="checkout-form"><label>Name<input name="name" required placeholder="Your name" value="${esc(cf.name||'')}" /></label>${contact}${extras}<button class="primary-button" type="submit">${preview?'Preview WhatsApp message':'Continue to WhatsApp'} <span>↗</span></button></form><div class="order-footnote">${state.service==='delivery'?'Delivery availability and charges will be confirmed by the restaurant and are not included in the subtotal.':'Payment is arranged directly with the restaurant.'}</div>`:'<div class="empty-order"><div>✦</div><h3>Your order is waiting</h3><p>Add a dish or drink to begin.</p><button class="primary-button" data-close="order" type="button">Explore menu</button></div>';$('#orderContent').querySelectorAll('[data-inc]').forEach(b=>b.onclick=()=>{saveCustomer();state.cart[b.dataset.inc].qty++;saveCart();renderOrder()});$('#orderContent').querySelectorAll('[data-dec]').forEach(b=>b.onclick=()=>{saveCustomer();const i=+b.dataset.dec;state.cart[i].qty--;if(state.cart[i].qty<1)state.cart.splice(i,1);saveCart();renderOrder()});$('#orderContent').querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{saveCustomer();state.cart.splice(+b.dataset.remove,1);saveCart();renderOrder()});$('#orderContent').querySelectorAll('[data-service]').forEach(b=>b.onclick=()=>{saveCustomer();state.service=b.dataset.service;renderOrder()});$('#checkoutForm')?.addEventListener('input',saveCustomer);$('#checkoutForm')?.addEventListener('submit',e=>{e.preventDefault();if(!e.target.reportValidity())return;saveCustomer();showMessagePreview()})}
function showMessagePreview(){const d=state.customer,total=subtotal();const itemText=state.cart.map(x=>`${x.qty} × ${x.name}${Object.values(x.preferences||{}).length?` [${Object.values(x.preferences).join(', ')}]`:''}${x.price==null?' — price to be confirmed':` — ${fmt(x.price*x.qty)}`}`).join('\n');let customer=`Name: ${d.name}`;if(state.service==='dine-in')customer+=`\nTable: ${d.table}`;else customer+=`\nPhone: ${d.phone}`;if(state.service==='takeaway')customer+=`\nPickup time: ${d.time}`;if(state.service==='delivery')customer+=`\nAddress: ${d.address}${d.location?`\nLocation: ${d.location}`:''}`;const msg=`HAANDI RESTAURANT ORDER\nBranch: ${$('#branchSelect').value}\nService: ${state.service}\n\n${customer}\n\nItems:\n${itemText}\n\nSubtotal: ${total===null?'Price to be confirmed':fmt(total)}${state.service==='delivery'?'\nDelivery charges: To be confirmed by the restaurant':''}\nPayment: Arranged directly with the restaurant.\n\nPlease confirm acceptance of this order.`;const handoff=CONFIG.liveOrdering&&total!==null;$('#orderContent').innerHTML=`<div class="message-preview"><div class="preview-label">MESSAGE PREVIEW</div><pre id="messageText">${esc(msg)}</pre><div class="preview-actions"><button class="secondary-button" id="backReview" type="button">Back to Review</button><button class="secondary-button" id="copyMessage" type="button">Copy order</button>${handoff?'<a class="primary-button" id="whatsApp" target="_blank" rel="noopener" href="#">Continue to WhatsApp ↗</a>':''}</div>${!handoff?'<p class="handoff-note">WhatsApp handoff is unavailable in preview mode or while any selected price is missing.</p>':'<p class="handoff-note">WhatsApp opens an unsubmitted message. Haandi must confirm acceptance.</p>'}</div>`;$('#backReview').onclick=()=>renderOrder();$('#copyMessage').onclick=()=>navigator.clipboard?.writeText(msg).then(()=>toast('Order copied to clipboard')).catch(()=>toast('Select and copy the message'));if(handoff)$('#whatsApp').href=`https://wa.me/${encodeURIComponent(CONFIG.whatsapp)}?text=${encodeURIComponent(msg)}`}
let categoryReturnFocus=null;
function openCategoryDialog(origin){categoryReturnFocus=origin;const dialog=$('#categoryDialog');dialog.inert=false;dialog.setAttribute('aria-hidden','false');$('.site-shell').inert=true;document.body.classList.add('sheet-open');$('#categoryBackdrop').hidden=false;$('#categorySearch').value='';renderCategoryOptions();setTimeout(()=>$('#categorySearch').focus(),0)}
function closeCategoryDialog(restore=true){const dialog=$('#categoryDialog');if(dialog.inert)return;dialog.inert=true;dialog.setAttribute('aria-hidden','true');$('.site-shell').inert=false;document.body.classList.remove('sheet-open');$('#categoryBackdrop').hidden=true;if(restore&&categoryReturnFocus?.isConnected)categoryReturnFocus.focus()}
function renderCategoryOptions(){const q=$('#categorySearch').value.trim().toLocaleLowerCase();const cats=activeCats().filter(([id,n])=>!q||n.toLocaleLowerCase().includes(q));$('#categoryDialogList').innerHTML=(state.mode==='food'?[['all','All Food'],...cats]:[['all','All Drinks'],...cats]).map(([id,n])=>{const count=id==='all'?(state.mode==='food'?FOOD.length:DRINKS.length):(state.mode==='food'?FOOD.filter(x=>x.category===id).length:DRINKS.filter(x=>x.category===id).length);const thumb=state.mode==='food'&&id!=='all'?'<span class="category-thumb"><img src="'+FOOD_CATEGORY_IMAGES[id]+'" alt="" /></span>':'<span class="category-thumb category-thumb-empty" aria-hidden="true">✦</span>';return '<button class="category-dialog-option '+(id===state.category?'selected':'')+'" data-category="'+id+'" type="button">'+thumb+'<span>'+esc(n)+'</span><small>'+count+'</small></button>'}).join('')||'<p class="category-no-results">No categories found.</p>'}
document.addEventListener('click',e=>{const cat=e.target.closest('[data-category]');if(cat){state.category=cat.dataset.category;render();if(!$('#categoryDialog').inert)closeCategoryDialog()}const card=e.target.closest('.menu-card');if(card){const id=card.dataset.id;const item=state.mode==='food'?FOOD.find(x=>x.id===id):DRINKS.find(x=>x.id===id);if(e.target.closest('.item-open')&&item)openDetail(item,e.target.closest('.item-open'));if(e.target.closest('[data-add]')&&item){if(state.mode==='food'&&item.spice)openDetail(item,e.target.closest('[data-add]'));else add(item)}}if(e.target.closest('[data-close]'))closeSheets()});
$('#searchInput').oninput=e=>{state.search=e.target.value;render()};$('#vegToggle').onclick=()=>{state.vegetarian=!state.vegetarian;$('#vegToggle').classList.toggle('active',state.vegetarian);$('#vegToggle').setAttribute('aria-pressed',state.vegetarian);render()};$('#categoryTrigger').onclick=e=>openCategoryDialog(e.currentTarget);$('#closeCategoryDialog').onclick=()=>closeCategoryDialog();$('#categoryBackdrop').onclick=()=>closeCategoryDialog();$('#categorySearch').oninput=renderCategoryOptions;$('#openCart').onclick=e=>{renderOrder();showSheet('order',e.currentTarget)};$('#backdrop').onclick=()=>closeSheets();
document.addEventListener('keydown',e=>{if(!$('#categoryDialog').inert){if(e.key==='Escape'){e.preventDefault();closeCategoryDialog()}if(e.key==='Tab'){const a=focusables($('#categoryDialog')),first=a[0],last=a.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}return}if(!state.dialog)return;if(e.key==='Escape'){e.preventDefault();closeSheets()}if(e.key==='Tab'){const a=focusables(state.dialog);if(!a.length){e.preventDefault();return}const first=a[0],last=a.at(-1);if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
document.querySelectorAll('.mode').forEach(b=>b.onclick=()=>{state.mode=b.dataset.mode;state.category='all';state.search='';$('#searchInput').value='';document.querySelectorAll('.mode').forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-selected',x===b)});render()});renderCartCount();render();
